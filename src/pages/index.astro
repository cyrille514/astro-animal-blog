---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio - GatitosApp">
  <section class="text-center py-12">
    <h1 class="text-5xl font-extrabold text-emerald-400 mb-4">¡Bienvenidos a AnimalesApp!</h1>
    <p class="text-lg text-slate-300 max-w-2xl mx-auto mb-8">
      Aplicación dedicada a explorar la diversidad y características de 10 razas de animales emblemáticos.
    </p>
    <a href="/blog" class="px-6 py-3 bg-emerald-500 text-slate-950 font-bold rounded-lg hover:bg-emerald-400 transition-colors">
      Explorar el Blog →
    </a>
  </section>
</Layout>
