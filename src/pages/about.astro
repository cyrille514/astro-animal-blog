---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sobre Mi - GatitosApp">
  <section class="max-w-2xl mx-auto py-12 text-center">
    <h1 class="text-3xl font-extrabold text-emerald-400 mb-6">Sobre Mi</h1>
    <p class="text-slate-300 leading-relaxed text-lg bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
      Hola, soy desarrollador en formación creando un sitio estático modular en Astro. Este proyecto demuestra el uso de componentes réutilisables, colecciones de contenido y CMS headless.
    </p>
  </section>
</Layout>

