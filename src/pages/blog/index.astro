---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const postsOrdenados = (posts || []).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const ultimoPost = postsOrdenados[0];
---

<Layout title="Blog - Inicio">
  <div class="space-y-8 py-6 max-w-3xl mx-auto">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold text-emerald-400 mb-3">El Blog del mundo animales</h1>
      <p class="text-slate-300">
        Bienvenido a la sección principal del blog. Descubre información sobre razas animales y sus cuidados.
      </p>
    </header>

    {ultimoPost && (
      <div>
        <h2 class="text-xs font-semibold uppercase text-emerald-400 tracking-wider mb-2">Última publicación:</h2>
        <PostCard post={ultimoPost} />
      </div>
    )}

    <div class="text-center pt-4">
      <a href="/blog/1" class="px-8 py-3 bg-emerald-500 text-slate-950 font-bold rounded-lg hover:bg-emerald-400 transition-colors inline-block shadow-lg">
        Ver todas las entradas (Paginación) →
      </a>
    </div>
  </div>
</Layout>