---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const cleanId = post.id.replace(/\.[^/.]+$/, "");
    return {
      params: { id: cleanId },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <article class="max-w-3xl mx-auto bg-orange-500 p-8 rounded-2xl border border-slate-700 shadow-xl my-6">
    <button onclick="history.back()" class="text-blue-700 hover:underline mb-6 font-semibold cursor-pointer border-none bg-transparent p-0">
      ← Volver
    </button>

    <h1 class="text-4xl font-extrabold text-emerald-400 mb-4">{post.data.title}</h1>
    
    <div class="flex items-center gap-4 text-xs text-slate-400 mb-6">
      <span class="bg-slate-700 px-2.5 py-1 rounded-md text-emerald-300 font-medium">{post.data.author}</span>
      <span>{new Date(post.data.pubDate).toLocaleDateString('es-ES')}</span>
    </div>

    {post.data.image?.url && (
      <img src={post.data.image.url} alt={post.data.image.alt || post.data.title} class="w-full h-80 object-cover rounded-xl mb-8 border border-slate-700 shadow-md" />
    )}

    <div class="prose prose-invert max-w-none text-slate-200 leading-relaxed space-y-4">
      <Content />
    </div>
  </article>
</Layout>
