---
// src/pages/blog/[page].astro
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getCollection('blog');
  const sortedPosts = (posts || []).sort(
    (a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  // Affiche 6 articles par page (3 lignes de 2 colonnes)
  return paginate(sortedPosts, { pageSize: 6 });
}

const { page } = Astro.props;
---

<Layout title={`Les races d'animaux - Page ${page.currentPage}`}>
  <section class="max-w-5xl mx-auto py-8 px-4">
    <!-- Fil d'ariane / Breadcrumb -->
    <nav class="text-xs text-white mb-4">
      <a href="/" class="hover:underline text-xl text-green-300 font-bold">Home</a> &gt; <span class="text-yellow-300 font-bold text-sm">Las Razas Animales</span>
    </nav>

    <!-- Titre et description de la section -->
    <h1 class="text-3xl font-bold text-violet-500 mb-3">Las Razas Animales</h1>
    <p class="text-white-600 text-xl  mb-8 leading-relaxed max-w-3xl">
      Descubre las diversas razas de animales en nuestro sitio. Explora información detallada sobre sus características, cuidados y consejos para conocerlos mejor en tu vida diaria.
    </p>

    <!-- Grille à 2 colonnes comme sur le modèle -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {page.data.map((post: any) => (
        <PostCard post={post} />
      ))}
    </div>

    <!-- Contrôles de pagination -->
    <div class="flex justify-between items-center mt-12 pt-6 border-t border-slate-200">
      {page.url.prev ? (
        <a 
          href={page.url.prev} 
          class="px-4 py-2 text-sm font-bold text-black bg-green-600 border border-teal-600 rounded hover:bg-teal-100 transition-colors"
        >
          ← Précédent
        </a>
      ) : (
        <div />
      )}

      <span class="text-xs text-slate-500 font-medium">
        Page {page.currentPage} sur {page.lastPage}
      </span>

      {page.url.next ? (
        <a 
          href={page.url.next} 
          class="px-4 py-2 text-sm font-semibold text-black bg-green-300 border border-teal-200 rounded hover:bg-teal-100 transition-colors"
        >
          Suivant →
        </a>
      ) : (
        <div />
      )}
    </div>
  </section>
</Layout>